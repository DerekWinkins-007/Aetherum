# Aetherum — environment variable template
# Copy this file to .env and fill in your values. Never commit .env to version control.

# Sepolia RPC endpoint (from Alchemy, Infura, or any Sepolia node)
SEPOLIA_RPC_URL=

# Deployer private key (hex, without 0x prefix). Keep this secret.
SEPOLIA_PRIVATE_KEY=

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=

# Pinata credentials for IPFS uploads
PINATA_JWT=
PINATA_GATEWAY=

# --- Frontend (Vite) variables ---
# These must be prefixed with VITE_ to be exposed in the browser bundle.
# Create frontend/.env (or copy these into a frontend/.env file) for Vite to pick them up.
VITE_PINATA_GATEWAY=
VITE_SEPOLIA_RPC_URL=
