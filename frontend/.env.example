# Vite environment variables for the frontend
# Copy this to frontend/.env and update values if needed

# Your Pinata gateway URL, must end with /ipfs/
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Sepolia RPC URL for read-only marketplace browsing (used for unauthenticated/incognito users).
# publicnode.com is more reliable than rpc.sepolia.org which is frequently rate-limited.
# You can also use a private Alchemy/Infura endpoint for best results.
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
